<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>SoundRouter third-party licenses</title>
<style>
body{font:14px -apple-system,sans-serif;max-width:50em;margin:2em auto;padding:0 1em}
pre{white-space:pre-wrap;background:#f4f4f4;padding:1em;border-radius:6px}
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
